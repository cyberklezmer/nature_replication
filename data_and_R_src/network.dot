digraph BN {
  graph [layout="dot", rankdir="TB", bgcolor="white"];
  node [shape="ellipse", style="filled", fillcolor="lightsteelblue", 
        color="navy", fontcolor="black", fontname="Arial", fontsize="12"];
  
  "gender" [label="gender"];
  "kar_praxe" [label="kar_praxe"];
  "kar_citace" [label="kar_citace"];
  "kar_nejlepsi" [label="kar_nejlepsi"];
  "pomer_zakladni" [label="pomer_zakladni"];
  "obor_dotovany" [label="obor_dotovany"];
  "obor_konkuren" [label="obor_konkuren"];
  "obor_rychly" [label="obor_rychly"];
  "obor_priliv" [label="obor_priliv"];
  "obor_publikac" [label="obor_publikac"];
  "obor_medializ" [label="obor_medializ"];
  "obor_verejnos" [label="obor_verejnos"];
  "obor_komplexn" [label="obor_komplexn"];
  "obor_mensi" [label="obor_mensi"];
  "cinnost_exper" [label="cinnost_exper"];
  "obor_ekzaktnost" [label="obor_ekzaktnost"];
  "krize_rep" [label="krize_rep"];
  "spec_hlavni" [label="spec_hlavni"];


  // Undirected edges
  "gender" -> "kar_citace" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "kar_praxe" -> "kar_citace" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "kar_praxe" -> "krize_rep" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "kar_citace" -> "kar_nejlepsi" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "kar_nejlepsi" -> "pomer_zakladni" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "obor_dotovany" -> "obor_priliv" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "obor_dotovany" -> "obor_medializ" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "obor_dotovany" -> "cinnost_exper" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "obor_konkuren" -> "obor_priliv" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "obor_konkuren" -> "obor_komplexn" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "obor_konkuren" -> "obor_mensi" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "obor_konkuren" -> "krize_rep" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "obor_rychly" -> "obor_priliv" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "obor_priliv" -> "obor_publikac" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "obor_medializ" -> "obor_verejnos" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "cinnost_exper" -> "spec_hlavni" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
  "obor_ekzaktnost" -> "spec_hlavni" [arrowhead="none", arrowtail="none", dir="none", color="darkblue", penwidth="2"];
}
